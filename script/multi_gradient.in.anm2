--filter
--label:${LABEL}
--information:${INFO} ${VERSION} by ${AUTHOR}
---$track:強さ
---min=0
---max=100
---step=0.01
local intensity = 100

--track0:中心X,-5000,5000,0,0.1
--track1:中心Y,-5000,5000,0,0.1
---$track:角度
---min=-360
---max=360
---step=0.1
local angle = 0

---$track:幅
---min=0
---max=2000
---step=1
local radius = 100

---$track:背景透明度
---min=0
---max=100
---step=0.01
local bg_alpha = 0

---$select:形状
---線形=0
---円形=1
---矩形=2
---凸形=3
---円形ループ=4
---矩形ループ=5
---凸形ループ=6
local gradient_type = 0

---$track:シフト
---min=-1000
---max=1000
---step=0.01
local shift = 0

---$select:境界モード
---境界色=0
---ループ=1
---ミラー=2
local edge_mode = 0

---$select:合成モード
---通常=0
---加算=1
---減算=2
---乗算=3
---スクリーン=4
---オーバーレイ=5
---比較(明)=6
---比較(暗)=7
---輝度=8
---色差=9
---陰影=10
---明暗=11
---差分=12
local blend_mode = 0

---$check:幅をオブジェクトに合わせる
local is_fit = 0

--group:グラデーションデータ,false
--separator:カラーマーカー

---$value:色
local col_table = {0x000000,0xffffff}

---$value:色の透明度
local alpha_table = {0.00,0.00}

---$value:位置
local pos_table = {0.00,1.00}

---$value:中間点
local mid_table = {0.50}

---$value:マーカー数
local marker_num = 2

--separator:透明度マーカー

---$value:透明度
local transparency_table = {1.00,1.00}

---$value:透明度位置
local transparency_pos_table = {0.00,1.00}

---$value:透明度マーカー数
local trans_marker_num = 2

--separator:その他

---$track:ぼかし幅
---min=0
---max=100
---step=1
local blur_width = 100

---$select:色空間
---sRGB=0
---Linear sRGB=1
---HSV=2
---HSL=3
---L*a*b=4
---LCh=5
---Oklab=6
---Oklch=7
local color_space = 0

---$select:補間経路
---短経路=0
---長経路=1
local interp_dir = 0

--group

--[[pixelshader@psmain:
---$include "color.hlsl"
---$include "multi_gradient.hlsl"
]]

--[[pixelshader@mask:
Texture2D<float4> src : register(t0);
float4 mask(float4 pos : SV_Position) : SV_Target {
    return src.Load(int3(pos.xy, 0));
}
]]

local MARKER_MAX_COUNT = 30
local GRADIENT_MAX_COUNT = MARKER_MAX_COUNT - 1

local function expand(t, max, def)
    for i = #t + 1, max do
        t[i] = def
    end
    return t
end

local colors = expand(col_table, MARKER_MAX_COUNT, 0x000000)
local alphas = expand(alpha_table, MARKER_MAX_COUNT, 0.0)
local positions = expand(pos_table, MARKER_MAX_COUNT, 0.0)
local midpoints = expand(mid_table, MARKER_MAX_COUNT, 0.5)
local transparency = expand(transparency_table, MARKER_MAX_COUNT, 0.0)
local transparency_pos = expand(transparency_pos_table, MARKER_MAX_COUNT, 0.0)

local function norm_color(color)
    local r, g, b = RGB(color)
    return {r / 255, g / 255, b / 255}
end

-- 非シーケンス、nil以外の値を渡された順番で1つのシーケンスにマージして返す
local function merge(...)
	local function flatten(v, res)
	    res = res or {}
	    if type(v) ~= "table" then
            res[#res + 1] = v
            return res
        end
	    for _, x in ipairs(v) do
            flatten(x, res)
        end
	    return res
	end
	local t = {...}
	return flatten(t)
end

-- テーブルの後ろ側に任意の長さだけ拡張する
local function extend_back(t, n, v)
	if type(v) == "nil" or type(v) == "table" then
		return
	end
	for i = 1, n do
		t[#t + 1] = v
	end
	return t
end

-- テーブルから指定した範囲を切り出す
local function slice(t, first, last)
    local res = {}
    for i = first, last do
        res[#res + 1] = t[i]
    end
    return res
end

-- 並び替え
local function reorder(t, idx)
    local r = {}
    for i, j in ipairs(idx) do
        r[i] = t[j]
    end
    return r
end

-- HLSL のコンスタントバッファーに渡すために変数を詰める
local function pack(colors, alphas, positions, midpoints, color_space, interp_dir, blur_width)
    assert(#colors == #alphas and #alphas == #positions and #positions == #midpoints, "Marker arrays must have the same length")

    -- マーカー数分だけ切り出す
    local marker_colors = slice(colors, 1, marker_num)
    local marker_alphas = slice(alphas, 1, marker_num)
    local marker_positions = slice(positions, 1, marker_num)
    local marker_midpoints = slice(midpoints, 1, marker_num)
    local marker_trans = slice(transparency, 1, trans_marker_num)
    local marker_trans_pos = slice(transparency_pos, 1, trans_marker_num)

    -- インデックス配列
    local idx = {}
    for i = 1, marker_num do
        idx[i] = i
    end

    -- 位置を基準にインデックスをソート
    table.sort(idx, function(a, b)
        local pa, pb = marker_positions[a], marker_positions[b]
        if pa ~= pb then
            return pa < pb
        end
        return a < b
    end)

    -- 位置を基準に並び替え
    marker_colors    = reorder(marker_colors, idx)
    marker_alphas    = reorder(marker_alphas, idx)
    marker_positions = reorder(marker_positions, idx)
    marker_midpoints = reorder(marker_midpoints, idx)

    local trans_idx = {}
    for i = 1, trans_marker_num do
        trans_idx[i] = i
    end

    table.sort(trans_idx, function(a, b)
        local pa, pb = marker_trans_pos[a], marker_trans_pos[b]
        if pa ~= pb then
            return pa < pb
        end
        return a < b
    end)

    marker_trans = reorder(marker_trans, trans_idx)
    marker_trans_pos = reorder(marker_trans_pos, trans_idx)

    -- 元のサイズに戻す
    marker_colors    = extend_back(marker_colors, MARKER_MAX_COUNT - #marker_colors, 0xffffff)
    marker_alphas    = extend_back(marker_alphas, MARKER_MAX_COUNT - #marker_alphas, 0)
    marker_positions = extend_back(marker_positions, MARKER_MAX_COUNT - #marker_positions, 0)
    marker_midpoints = extend_back(marker_midpoints, MARKER_MAX_COUNT - #marker_midpoints, 0.5)
    marker_trans     = extend_back(marker_trans, MARKER_MAX_COUNT - #marker_trans, 0)
    marker_trans_pos = extend_back(marker_trans_pos, MARKER_MAX_COUNT - #marker_trans_pos, 0)

    local start_col = {}; local start_pos = {};
    local stop_col = {}; local stop_pos = {};
    local mid = {};

    for i = 1, MARKER_MAX_COUNT do
        -- 区間の開始
        local start_rgb = norm_color(marker_colors[i] or 0x000000)
        start_col[#start_col + 1] = start_rgb[1]
        start_col[#start_col + 1] = start_rgb[2]
        start_col[#start_col + 1] = start_rgb[3]
        start_col[#start_col + 1] = 1-marker_alphas[i] or 1
        start_pos[#start_pos + 1] = marker_positions[i]
        mid[#mid + 1] = marker_midpoints[i]  -- 中間点は区間の開始位置に対応させる

        -- 区間の終了
        local next_i = i + 1
        if next_i > MARKER_MAX_COUNT then next_i = MARKER_MAX_COUNT end

        local stop_rgb = norm_color(marker_colors[next_i] or 0x000000)
        stop_col[#stop_col + 1] = stop_rgb[1]
        stop_col[#stop_col + 1] = stop_rgb[2]
        stop_col[#stop_col + 1] = stop_rgb[3]
        stop_col[#stop_col + 1] = 1-marker_alphas[next_i] or 1
        stop_pos[#stop_pos + 1] = marker_positions[next_i]
    end

    -- [0] = 区間の開始位置, [1] = 区間の終了位置, [2] = 中間点, [3] = パディング
    local pos_and_mid = {}
    for i = 1, GRADIENT_MAX_COUNT do
        pos_and_mid[#pos_and_mid + 1] = start_pos[i]
        pos_and_mid[#pos_and_mid + 1] = stop_pos[i]
        pos_and_mid[#pos_and_mid + 1] = mid[i]
        pos_and_mid[#pos_and_mid + 1] = 0.0  -- パディング
    end

    -- [i+0] = 透明度マーカーの位置, [i+1] = 透明度マーカーの位置, [i+2] = 透明度マーカーの値, [i+3] = 透明度マーカーの値,
    local trans_pos_and_value = {}
    for i = 1, GRADIENT_MAX_COUNT do
        trans_pos_and_value[#trans_pos_and_value + 1] = marker_trans_pos[i]
        trans_pos_and_value[#trans_pos_and_value + 1] = marker_trans_pos[i + 1]
        trans_pos_and_value[#trans_pos_and_value + 1] = marker_trans[i]
        trans_pos_and_value[#trans_pos_and_value + 1] = marker_trans[i + 1]
    end

    marker_num = math.min(math.max(marker_num, 2), MARKER_MAX_COUNT)
    trans_marker_num = math.min(math.max(trans_marker_num, 2), MARKER_MAX_COUNT)

    local packed = merge(
        {color_space, interp_dir, blur_width / 100, marker_num},
        start_col,
        stop_col,
        pos_and_mid,
        {trans_marker_num, 0, 0, 0},
        trans_pos_and_value
    )

    -- packed の構造は以下のようになる（float4 の配列として渡すため、4つずつまとめる）
    -- [0] = 色空間, [1] = 補間経路, [2] = ぼかし幅, [3] = マーカー数,
    -- [i+0] = 開始色.r, [i+1] = 開始色.g, [i+2] = 開始色.b, [i+3] = 開始色.a,
    -- ...（最大マーカー数分）
    -- [i+0] = 終了色.r, [i+1] = 終了色.g, [i+2] = 終了色.b, [i+3] = 終了色.a,
    -- ...（最大マーカー数分）
    -- [i+0] = 区間の開始位置, [i+1] = 区間の終了位置, [i+2] = 中間点, [i+3] = パディング
    -- ...（最大区間数分）
    -- [0] = 透明度マーカー数, [1] = パディング, [2] = パディング, [3] = パディング,
    -- [i+0] = 透明度マーカーの位置, [i+1] = 透明度マーカーの位置, [i+2] = 透明度マーカーの値, [i+3] = 透明度マーカーの値,
    -- ...（最大区間数分）


    return packed
end

local function rotate(deg)
    local rad = math.rad(deg)
    return {math.cos(rad), -math.sin(rad),
            math.sin(rad),  math.cos(rad)}
end

local constants = pack(colors, alphas, positions, midpoints, color_space, interp_dir, blur_width)
local PAD = 0.0

local n = obj.setanchor("track", 0, "line")
local center_x = obj.track0
local center_y = obj.track1
local m00, m01, m10, m11 = unpack(rotate(angle))
local cache_name = "orig_img_"..tostring(obj.id)

obj.copybuffer("cache:"..cache_name, "object")
obj.setoption("drawtarget", "tempbuffer", obj.w, obj.h)
obj.draw(0.0, 0.0, 0.0, 1.0, (100 - bg_alpha) / 100)

obj.pixelshader("psmain", "object", {"object"},
    {
        obj.w, obj.h, center_x, center_y,
        radius, gradient_type, is_fit, shift / 100,
        edge_mode, PAD, PAD, PAD,
        m00, m01, PAD, PAD,
        m10, m11, PAD, PAD,
        unpack(constants),
    },
    "copy"
)

obj.setoption("blend", blend_mode)
obj.draw(0.0, 0.0, 0.0, 1.0, intensity / 100.0)
obj.copybuffer("obj", "tmp")
obj.setoption("blend", 0)

obj.pixelshader("mask", "object", {"cache:"..cache_name}, {}, "mask")
